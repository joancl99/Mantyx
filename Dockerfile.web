# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM node:24-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.5.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm nx build web --configuration=production

# ── Stage 2: Runner (Nginx) ───────────────────────────────────────────────────
# Use the moving `stable-alpine-slim` tag: rebuilt on the latest patched Alpine
# minor (far fewer OS CVEs than a frozen `1.x-alpine` snapshot), and the `-slim`
# variant drops dynamic modules we don't use (njs, geoip, perl) — leaving 0
# critical/high CVEs. We only serve static files + reverse-proxy, so it's drop-in.
FROM nginx:stable-alpine-slim AS runner

COPY --from=builder /app/dist/apps/web/browser /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
