# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM node:24-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.5.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm exec prisma generate --schema=apps/api/prisma/schema.prisma
# Webpack (generatePackageJson: true) emits dist/apps/api/package.json containing
# ONLY the dependencies the API bundle actually imports — no Angular/Capacitor/etc.
RUN pnpm nx build api --configuration=production

# ── Stage 2: Production dependencies ──────────────────────────────────────────
# Install from the PRUNED package.json so the runtime image carries only the API's
# real runtime deps (not the whole monorepo). node-linker=hoisted flattens
# node_modules so the bundle can require transitive deps (e.g. tslib via rxjs).
FROM node:24-alpine AS prod-deps
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.5.0 --activate

COPY --from=builder /app/dist/apps/api/package.json ./package.json
# node-linker=hoisted flattens node_modules; the workspace file approves the
# native/postinstall build scripts (bcrypt, prisma engines) for pnpm 11.
COPY docker/prod-deps.npmrc ./.npmrc
COPY docker/prod-deps.pnpm-workspace.yaml ./pnpm-workspace.yaml
# Webpack's generatePackageJson omits tslib even though the tsc-compiled bundle
# requires it at runtime — add it explicitly before installing.
RUN node -e "const p=require('./package.json'); p.dependencies.tslib=p.dependencies.tslib||'^2.8.1'; require('fs').writeFileSync('package.json', JSON.stringify(p,null,2))" \
  && pnpm install --prod

COPY apps/api/prisma ./apps/api/prisma
RUN pnpm exec prisma generate --schema=apps/api/prisma/schema.prisma

# ── Stage 3: Runner ───────────────────────────────────────────────────────────
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=builder /app/dist/apps/api ./dist/apps/api
COPY --from=prod-deps /app/apps/api/prisma ./apps/api/prisma

RUN mkdir -p uploads/products

COPY docker/api-entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

EXPOSE 3000
ENTRYPOINT ["./entrypoint.sh"]
