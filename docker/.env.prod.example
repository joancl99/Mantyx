# PostgreSQL
POSTGRES_USER=mantyx
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=mantyx

# Redis
REDIS_PASSWORD=change_me_in_production

# JWT — high-entropy random secrets, min 32 chars / 256-bit (openssl rand -hex 32).
# The app refuses to boot if these are shorter than 32 chars.
JWT_ACCESS_SECRET=change_me_use_openssl_rand_hex_32_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_use_openssl_rand_hex_32_min
JWT_REFRESH_EXPIRES_IN=7d

# CORS — set to your actual domain (e.g. https://app.tudominio.com). Must be a
# valid URL, never "*" (credentials are enabled).
CORS_ORIGIN=http://localhost

# Web port exposed on host
WEB_PORT=80
