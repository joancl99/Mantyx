# PostgreSQL
POSTGRES_USER=mantyx
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=mantyx

# Redis
REDIS_PASSWORD=change_me_in_production

# JWT — use long random strings (e.g. openssl rand -hex 32)
JWT_ACCESS_SECRET=change_me_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_in_production
JWT_REFRESH_EXPIRES_IN=7d

# CORS — set to your actual domain in production
CORS_ORIGIN=http://localhost

# Web port exposed on host
WEB_PORT=80
